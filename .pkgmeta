# BigWigs packager / CurseForge packaging. The addon lives in Wayward/; the
# rest of the repository (the WFProbe dev addon, tests, tools, docs) stays out.
package-as: Wayward

# The changelog players see (CurseForge, the GitHub release) is written by
# hand; the generated one is every commit message since the last tag.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

move-folders:
  Wayward/Wayward: Wayward

ignore:
  - WFProbe
  - tests
  - tools
  - docs
  - art
  - README.md
  - CLAUDE.md
  - .pkgmeta
  - .gitignore
  - .claude
